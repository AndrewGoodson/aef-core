    )
    result.add(
        "a repo that never reported is distinct from one that went stale",
        fleet_mod.STATE_TREATMENT["never"] != fleet_mod.STATE_TREATMENT["stale"],
    )
    result.add(
        "a collection error is distinct from no data",
        fleet_mod.STATE_TREATMENT["error"] != fleet_mod.STATE_TREATMENT["never"],
    )

    ghost = fleet_mod.left_join(
        registry, data_through=through, expected_interval_seconds=3600,
        emitters={"ghost-repo"},
    )
    result.add(
        "telemetry from an unregistered repo is surfaced, not dropped",
