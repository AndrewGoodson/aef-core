        html_text.split('id="mind-data">', 1)[1].split("</script>", 1)[0]
    )["fleet"]["rows"])):
        result.add(f"fleet row rendered for {repo}", repo in html_text)


def check_exceptions(result: Result) -> None:
    """Stage 4.2 — the queue's value is in what it EXCLUDES.

    A rejection is the gate working. A queue listing them would always be full,
    and a full queue is one nobody reads — so the exclusion is checked as
    carefully as the inclusion.
    """
    from datetime import UTC, datetime, timedelta

    sys.path.insert(0, str(ROOT / "pipeline"))
    import exceptions as exc  # type: ignore[import-not-found]

    through = datetime(2026, 8, 5, 17, 42, tzinfo=UTC)
    cohort = json.loads((ROOT / "fixtures" / "fleet.json").read_text())["cohort"]

    items = exc.collect(fleet_rows=[], gates=[], cohort=cohort, data_through=through)
    listed = {i.subject for i in items}
    leaked = sorted(listed & exc.ROUTINE_OUTCOMES)
    result.add(
        "no ordinary rejection reaches the queue",
        not leaked,
        f"leaked: {leaked}" if leaked else "",
    )
    result.add("a rollback does reach the queue", any(i.kind == "rollback" for i in items))

    # Out-of-band must fire in BOTH directions. A gate that stopped rejecting
    # and a generator that broke look opposite and are both abnormal.
    def band(count: int) -> list[Any]:
        return exc.collect(
            fleet_rows=[],
            gates=[],
            cohort={
                "proposed": 412,
                "branches": [
                    {"outcome": "static_rejected", "count": count,
                     "expected_range": [40, 52], "tone": "neutral"}
                ],
            },
            data_through=through,
        )

    result.add(
        "a collapsed rejection rate is flagged (the gate stopped)",
        any(i.kind == "out_of_band" for i in band(4)),
    )
    result.add(
        "a surging rejection rate is flagged (the generator broke)",
        any(i.kind == "out_of_band" for i in band(410)),
    )

    def gate(hours: float | None, disposition: str = "awaiting") -> list[Any]:
        entry: dict[str, Any] = {"edge": ["a", "b"], "disposition": disposition}
        if hours is not None:
            entry["pending_since"] = (
                (through - timedelta(hours=hours)).isoformat().replace("+00:00", "Z")
            )
        return exc.collect(fleet_rows=[], gates=[entry], cohort=None, data_through=through)

    result.add("a decision pending 30h is flagged", any(i.kind == "decision_overdue" for i in gate(30)))
    result.add("a decision pending 2h is not flagged", not gate(2))
    result.add(
        "an awaiting gate with no start time is still raised",
        bool(gate(None)),
    )
    result.add("a decided gate raises nothing", not gate(1, "approved"))

    if not DIST.is_file():
        return
    html_text = DIST.read_text(encoding="utf-8")
    result.add(
        "the page states what the queue deliberately excluded",
        "the gate working as designed" in html_text,
    )
    result.add(
        "the page states what it cannot detect at all",
        "Not detectable from the available data" in html_text,
    )
    result.add(
        "the overdue-decision window is stated on the page",
        "counts as overdue after" in html_text,
    )


def check_cohort(result: Result) -> None:
    """Stage 4.3 — CONSORT, not a funnel, and every proposal accounted for."""
    sys.path.insert(0, str(ROOT / "pipeline"))
    import cohort as cohort_mod  # type: ignore[import-not-found]

    raw = json.loads((ROOT / "fixtures" / "fleet.json").read_text())["cohort"]
    built = cohort_mod.build(raw)
    assert built is not None
    result.add("cohort builds", True)

    counted = sum(b.count for b in built.branches) + built.unclassified
    result.add(
        "branches plus unclassified equal the cohort",
        counted == built.proposed,
        f"{counted} vs {built.proposed}",
    )
    result.add("nothing is unaccounted for", built.unaccounted == 0, str(built.unaccounted))
    result.add(
        f"at most {cohort_mod.MAX_BRANCHES} top-level outcomes",
        len(built.branches) <= cohort_mod.MAX_BRANCHES,
        f"{len(built.branches)}",
    )

    # THE verdict: rejection is never abnormal on its own.
    rejections = [b for b in built.branches if "rejected" in b.outcome]
    result.add("the fixture exercises rejection branches", len(rejections) >= 2)
    red = [b.outcome for b in rejections if b.treatment == "abnormal" and b.tone != "abnormal"]
    result.add(
        "an in-band rejection branch is NEVER drawn abnormal",
        not red,
        f"drawn red: {red}" if red else "",
    )
    result.add(
        "a rollback IS drawn abnormal",
        any(b.treatment == "abnormal" for b in built.branches if b.tone == "abnormal"),
    )

    # A branch with no historical range is unknown, not "in band".
    solo = cohort_mod.build(
        {"proposed": 10, "branches": [{"outcome": "x", "count": 5, "tone": "neutral"}]}
    )
    assert solo is not None
    result.add(
        "a branch with no expected range reads unknown, not in-band",
        solo.branches[0].band == "unknown" and solo.branches[0].treatment == "unknown",
    )
    result.add(
        "missing proposals are surfaced, not absorbed",
        solo.unaccounted == 5,
        f"unaccounted={solo.unaccounted}",
    )

    # An out-of-band rate IS abnormal — that is about the rate, not the rejection.
    drifted = cohort_mod.build(
        {"proposed": 100,
         "branches": [{"outcome": "static_rejected", "count": 5,
                       "expected_range": [40, 52], "tone": "neutral"}]}
    )
    assert drifted is not None
    result.add(
        "a rejection rate outside its own band IS abnormal",
        drifted.branches[0].treatment == "abnormal",
    )

    for bad, why in (
        ({"proposed": 0, "branches": []}, "empty cohort"),
        ({"proposed": 10, "branches": [{"outcome": f"o{i}", "count": 1} for i in range(7)]},
         "too many branches"),
    ):
        try:
            cohort_mod.build(bad)
            refused = False
        except cohort_mod.CohortError:
            refused = True
        result.add(f"{why} is refused", refused)

    if not DIST.is_file():
        return
    html_text = DIST.read_text(encoding="utf-8")
    result.add("the cohort flow is rendered", 'id="cohort-flow"' in html_text)
    result.add(
        "the unclassified row is rendered even at zero",
        "unclassified" in html_text and "no recorded outcome" in html_text,
    )
    result.add(
        "the page states that rejection branches are neutral by design",
        "a rejected proposal is the gate working" in html_text,
    )
    result.add(
        "the page states the per-stage durations it does not have",
        "time-in-stage" in html_text,
    )


def check_stability(result: Result) -> None:
    """Stage 4.4 — a band chart, and honest about not being a control chart."""
    sys.path.insert(0, str(ROOT / "pipeline"))
    import stability as stab  # type: ignore[import-not-found]

    raw = json.loads((ROOT / "fixtures" / "fleet.json").read_text())
    built = stab.build(raw["cohort"], {"total": 4, "fresh": 1})

    result.add("nothing claims a time series", built["has_series"] is False)
    result.add(
        "no metric claims a series",
        not any(m["has_series"] for m in built["metrics"]),
    )
    result.add("the payload names the chart kind", built["chart_kind"] == "band")
    result.add(
        "the payload explains why it is not a control chart",
        "successive observations" in built["why_not_control_chart"],
    )

    unbanded = [m for m in built["metrics"] if m["band_low"] is None]
    result.add("the fixture exercises an unbanded metric", len(unbanded) >= 1)
    passing = [m["key"] for m in unbanded if m["treatment"] == "neutral"]
    result.add(
        "a metric with no baseline NEVER reads as passing",
        not passing,
        f"passing without a band: {passing}" if passing else "",
    )

    # The report's own worked example, reproduced exactly.
    def classify(count: int) -> str:
        return stab.build(
            {"proposed": 100, "window_days": 30,
             "branches": [{"outcome": "static_rejected", "count": count,
                           "expected_range": [88, 93]}]},
            None,
        )["metrics"][0]["status"]

    result.add("90% against an 88-93% band reads healthy", classify(90) == "in")
    result.add("55% against an 88-93% band reads BELOW (the gate stopped)", classify(55) == "below")
    result.add("100% against an 88-93% band reads ABOVE (the generator broke)", classify(100) == "above")

    absent = stab.Metric(key="x", label="x", unit="%", observation=None, band_low=0, band_high=100)
    result.add(
        "a metric with no observation is not compared anyway",
        absent.status == "unknown" and absent.treatment == "unknown",
    )
    result.add(
        "metrics the record does not carry are listed, not omitted",
        len(built["absent"]) >= 2,
        str([a["metric"] for a in built["absent"]]),
    )

    if not DIST.is_file():
        return
    html_text = DIST.read_text(encoding="utf-8")
    result.add("the band chart is rendered", 'id="stability-bands"' in html_text)
    result.add(
        "the page says it is a band chart, not a control chart",
        "no series recorded" in html_text and "no run rules" in html_text,
    )
    result.add(
        "the page names the metrics it cannot show",
        "not recorded" in html_text and "decision latency" in html_text,
    )
    result.add("no trend line is drawn anywhere", "polyline" not in html_text)


