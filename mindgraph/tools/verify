#!/usr/bin/env python3
"""Verifier for the delivered artifact. Extended as stages demand.

Design note: this script must be able to FAIL. A verifier that cannot detect
is not a verifier, so `--self-test` plants each fault it claims to catch and
asserts the check fires. Run it before trusting a green result.
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DIST = ROOT / "dist" / "index.html"
FIXTURES = ROOT / "fixtures" / "fleet.json"

# Every token the spec's Hard Constraints forbid in the DELIVERED file.
# Written as (label, pattern) so a failure names the mechanism, not the regex.
FORBIDDEN: tuple[tuple[str, str], ...] = (
    ("network: fetch", r"\bfetch\s*\("),
    ("network: XMLHttpRequest", r"\bXMLHttpRequest\b"),
    ("network: WebSocket", r"\bWebSocket\b"),
    ("network: sendBeacon", r"\bsendBeacon\b"),
    ("write: form element", r"<form\b"),
    ("storage: localStorage", r"\blocalStorage\b"),
    ("storage: sessionStorage", r"\bsessionStorage\b"),
    ("storage: indexedDB", r"\bindexedDB\b"),
    ("external ref: src=http", r"""\bsrc\s*=\s*["']?https?:"""),
    ("external ref: href=http", r"""\bhref\s*=\s*["']?https?:"""),
    ("external ref: @import", r"@import\b"),
    ("external ref: url(http", r"url\(\s*['\"]?https?:"),
    ("non-determinism: Math.random", r"\bMath\.random\b"),
    # A runtime layout would recompute positions on open, which is exactly
    # what Section 3(a)'s verdict rules out: the same data would render
    # differently every time and the reader's spatial memory — the whole value
    # — would be worthless. Coordinates are baked; nothing in the delivered
    # file may simulate.
    ("runtime layout: forceSimulation", r"\bforceSimulation\b"),
    ("runtime layout: forceLink", r"\bforceLink\b"),
    ("runtime layout: forceManyBody", r"\bforceManyBody\b"),
    ("runtime layout: velocityDecay", r"\bvelocityDecay\b"),
    ("runtime layout: simulation.tick", r"\.tick\s*\("),
)

# A static file must never claim to be live. The staleness it reports has to
# come from the embedded timestamps, which is the only honest thing it can say.
FORBIDDEN_TEXT: tuple[tuple[str, str], ...] = (("claims to be LIVE", r"\bLIVE\b"),)

REQUIRED_TIMESTAMPS = ("generated_at", "data_through")


class Result:
    def __init__(self) -> None:
        self.checks: list[tuple[str, bool, str]] = []

    def add(self, name: str, ok: bool, detail: str = "") -> None:
        self.checks.append((name, ok, detail))

    @property
    def failed(self) -> list[tuple[str, bool, str]]:
        return [c for c in self.checks if not c[1]]

    def report(self) -> int:
        width = max(len(n) for n, _, _ in self.checks) if self.checks else 10
        for name, ok, detail in self.checks:
            mark = "PASS" if ok else "FAIL"
            line = f"  {mark}  {name.ljust(width)}"
            if detail:
                line += f"  {detail}"
            print(line)
        print()
        if self.failed:
            print(f"VERIFY: FAIL ({len(self.failed)} of {len(self.checks)})")
            return 1
        print(f"VERIFY: PASS ({len(self.checks)} checks)")
        return 0


def scan_forbidden(html: str, result: Result) -> None:
    for label, pattern in FORBIDDEN:
        hit = re.search(pattern, html)
        result.add(
            f"forbidden token absent — {label}",
            hit is None,
            "" if hit is None else f"found at offset {hit.start()}: {hit.group(0)!r}",
        )
    for label, pattern in FORBIDDEN_TEXT:
        hit = re.search(pattern, html)
        result.add(
            f"honest staleness — not {label}",
            hit is None,
            "" if hit is None else "a static file must not label itself LIVE",
        )


def embedded_json(html: str) -> dict | None:
    m = re.search(
        r'<script[^>]*type=["\']application/json["\'][^>]*>(.*?)</script>',
        html,
        re.DOTALL,
    )
    if not m:
        return None
    try:
        parsed = json.loads(m.group(1))
    except json.JSONDecodeError:
        return None
    return parsed if isinstance(parsed, dict) else {"_": parsed}


def check_payload(html: str, result: Result) -> None:
    payload = embedded_json(html)
    result.add("embedded JSON block parses", payload is not None)
    if payload is None:
        return
    for key in REQUIRED_TIMESTAMPS:
        result.add(f"payload carries {key}", key in payload, "" if key in payload else "missing")


def check_fixtures(result: Result) -> None:
    """The fixture must actually contain every edge case the spec's rules are
    tested against. A fixture missing a case makes every downstream assertion
    about it vacuously true."""
    if not FIXTURES.is_file():
        result.add("fixtures present", False, f"{FIXTURES} missing")
        return
    data = json.loads(FIXTURES.read_text())
    node_states = {n.get("operational_state") for n in data.get("nodes", [])}
    edge_states = {e.get("edge_state") for e in data.get("edges", [])}
    telemetry = {r.get("telemetry") for r in data.get("registry", [])}
    gate_dispositions = {g.get("disposition") for g in data.get("gates", [])}
    tones = {b.get("tone") for b in data.get("cohort", {}).get("branches", [])}

    required = (
        ("fixture: repo that stopped reporting", "stale" in telemetry),
        ("fixture: repo that never reported", "never" in telemetry),
        ("fixture: collection error distinct from no-data", "error" in telemetry),
        ("fixture: uninstrumented node", None in node_states),
        ("fixture: stale node", "stale" in node_states),
        ("fixture: never-observed edge", "never_observed" in edge_states),
        ("fixture: dormant (used-then-abandoned) edge", "dormant" in edge_states),
        ("fixture: explicitly retired edge", "retired" in edge_states),
        ("fixture: unknown-coverage edge", "unknown" in edge_states),
        ("fixture: pending human gate", "awaiting" in gate_dispositions),
        ("fixture: approved-then-rolled-back change", "abnormal" in tones),
    )
    for name, ok in required:
        result.add(name, bool(ok))

    # The distinction the whole encoding exists for, asserted on the DATA
    # before any renderer can blur it.
    dormant = [e for e in data.get("edges", []) if e.get("edge_state") == "dormant"]
    never = [e for e in data.get("edges", []) if e.get("edge_state") == "never_observed"]
    ok = bool(dormant and never)
    if ok:
        ok = (
            dormant[0]["lifetime_traversal_count"] > 0
            and never[0]["lifetime_traversal_count"] == 0
            and never[0]["last_traversal_at"] is None
        )
    result.add(
        "dormant and never-observed are separable in the data",
        ok,
        "" if ok else "dormant must have count>0; never-observed must have count==0 and no last traversal",
    )


def check_contract(result: Result) -> None:
    """Stage 0. The contract must make the UNKNOWN construction unreachable by
    defaulting, and it must actually fire on the fixture's uninstrumented node."""
    sys.path.insert(0, str(ROOT / "pipeline"))
    try:
        import contract  # type: ignore[import-not-found]
    except ImportError as exc:
        result.add("contract module importable", False, str(exc))
        return
    result.add("contract module importable", True)

    data = json.loads(FIXTURES.read_text())
    nodes = {n["id"]: n for n in data["nodes"]}

    ghost = contract.resolve_node(nodes["legacy_scorer"])
    result.add(
        "uninstrumented node forces the UNKNOWN construction",
        contract.is_unknown_node(ghost),
    )
    result.add(
        "uninstrumented node gets hatched fill and broken border",
        ghost["node.fill"].value.get("fill") == "hatched"
        and ghost["node.fill"].value.get("border") == "broken",
    )
    result.add(
        "unknown radius does not fall back to a normal size",
        ghost["node.radius"].construction is contract.Construction.UNKNOWN,
    )

    healthy = contract.resolve_node(nodes["ingest"])
    result.add(
        "control — an instrumented node resolves as measured",
        not contract.is_unknown_node(healthy),
    )
    result.add(
        "control — measured radius differs from the unknown radius",
        healthy["node.radius"].value != ghost["node.radius"].value,
    )
    result.add(
        "UNKNOWN and MEASURED are distinct constructions",
        ghost["node.fill"].construction != healthy["node.fill"].construction,
    )

    edges = {(e["source"], e["target"]): e for e in data["edges"]}
    unknown_edge = contract.resolve_edge(edges[("legacy_scorer", "emit")])
    result.add(
        "unknown-coverage edge makes no zero-count claim",
        unknown_edge["edge.rail_width"].value.get("makes_zero_claim") is False,
    )
    never = contract.resolve_edge(edges[("fetch_invoice", "human_gate")])
    result.add(
        "never-observed edge resolves its count (it is a real zero)",
        never["edge.rail_width"].is_measured and never["edge.rail_width"].value == 0,
    )
    result.add(
        "never-observed and unknown-coverage resolve differently",
        never["edge.rail_width"].construction != unknown_edge["edge.rail_width"].construction,
    )
    result.add(
        "every declared channel names a backing field",
        all(ch.backing for ch in contract.ALL_CHANNELS),
    )
    # Reproduced in Stage 0's self-critique: UNKNOWN_TREATMENT was a plain dict
    # handed out as the value of every unresolved channel, so one caller
    # writing value["fill"] = "solid" turned every subsequent UNKNOWN healthy —
    # the cardinal anti-pattern as a one-line accident.
    try:
        ghost["node.fill"].value["fill"] = "solid"  # type: ignore[index]
        frozen = False
    except TypeError:
        frozen = True
    result.add("UNKNOWN treatment cannot be mutated by a caller", frozen)
    result.add(
        "UNKNOWN treatment's backing dict is not left bound",
        not hasattr(contract, "_UNKNOWN_TREATMENT"),
        "" if not hasattr(contract, "_UNKNOWN_TREATMENT") else "MappingProxyType is a view",
    )
    try:
        contract.assert_complete()
        complete = True
        detail = contract.coverage()
    except contract.ContractError as exc:
        complete, detail = False, str(exc)
    result.add("Stage 0 threshold — every visual property is backed", complete, detail)

    load = contract.preattentive_load(healthy)
    result.add(
        f"preattentive load within budget ({contract.PREATTENTIVE_BUDGET})",
        load <= contract.PREATTENTIVE_BUDGET,
        f"load={load}",
    )


def check_traversal(result: Result) -> None:
    """Stage 1.1. The derivation must produce all five edge states from the
    event log + declared topology, and must not confuse the two that matter."""
    sys.path.insert(0, str(ROOT / "pipeline"))
    from datetime import datetime

    try:
        import traversal  # type: ignore[import-not-found]
    except ImportError as exc:
        result.add("traversal module importable", False, str(exc))
        return
    result.add("traversal module importable", True)

    events = traversal.read_events(ROOT / "fixtures" / "events.jsonl")
    topo = json.loads((ROOT / "fixtures" / "topology.json").read_text())
    through = datetime.fromisoformat(
        topo.get("data_through", "2026-08-05T17:42:00+00:00").replace("Z", "+00:00")
    )
    nodes, edges = traversal.derive(events, topo, data_through=through)
    by_pair = {(e.source, e.target): e for e in edges}
    states = {e.edge_state.value for e in edges}

    for want in ("active", "dormant", "never_observed", "retired", "unknown"):
        result.add(f"derivation produces the {want} state", want in states)

    # The distinction the artifact exists for, checked on DERIVED output rather
    # than on a hand-written fixture that could simply assert it.
    dormant = by_pair[("classify", "fetch_invoice")]
    never = by_pair[("fetch_invoice", "human_gate")]
    result.add(
        "dormant carries a real history (count > 0)",
        dormant.lifetime_traversal_count is not None and dormant.lifetime_traversal_count > 0,
        f"count={dormant.lifetime_traversal_count}",
    )
    result.add(
        "never-observed is a real zero with no last traversal",
        never.lifetime_traversal_count == 0 and never.last_traversal_at is None,
    )
    result.add(
        "dormant and never-observed derive to different states",
        dormant.edge_state != never.edge_state,
    )

    # Absence of telemetry must never become a zero-count claim.
    unknown = by_pair[("legacy_scorer", "emit")]
    result.add(
        "unknown-coverage edge makes no count claim at all",
        unknown.lifetime_traversal_count is None,
        f"count={unknown.lifetime_traversal_count}",
    )
    ghost = next(n for n in nodes if n.id == "legacy_scorer")
    result.add(
        "uninstrumented node reports None, not 0",
        ghost.lifetime_execution_count is None,
    )

    # Retired must come from config, never inferred from inactivity.
    retired = by_pair[("classify", "legacy_scorer")]
    result.add(
        "retired comes from config, not from inactivity",
        retired.edge_state.value == "retired" and retired.retired_at is not None,
    )

    # Determinism: the same inputs must derive the same graph.
    again = traversal.derive(events, topo, data_through=through)
    result.add(
        "derivation is deterministic",
        [e.to_payload() for e in again[1]] == [e.to_payload() for e in edges],
    )


def check_layout(result: Result) -> None:
    """Stage 1.2. Determinism is the whole property; everything else follows."""
    sys.path.insert(0, str(ROOT / "pipeline"))
    from datetime import datetime

    try:
        import layout  # type: ignore[import-not-found]
        import traversal  # type: ignore[import-not-found]
    except ImportError as exc:
        result.add("layout module importable", False, str(exc))
        return
    result.add("layout module importable", True)

    events = traversal.read_events(ROOT / "fixtures" / "events.jsonl")
    topo = json.loads((ROOT / "fixtures" / "topology.json").read_text())
    nodes, edges = traversal.derive(
        events, topo, data_through=datetime.fromisoformat("2026-08-05T17:42:00+00:00")
    )
    ids = [n.id for n in nodes]
    el = [(e.source, e.target, e.lifetime_traversal_count or 0) for e in edges]

    first = layout.compute(ids, el)
    second = layout.compute(ids, el)
    result.add(
        "layout is deterministic across runs",
        {k: (v.x, v.y) for k, v in first.items()} == {k: (v.x, v.y) for k, v in second.items()},
    )
    shuffled = layout.compute(list(reversed(ids)), list(reversed(el)))
    result.add(
        "layout does not depend on input ordering",
        {k: (v.x, v.y) for k, v in first.items()} == {k: (v.x, v.y) for k, v in shuffled.items()},
    )

    # No RNG anywhere in the pipeline, checked as source rather than trusted.
    for module in ("layout.py", "traversal.py", "contract.py"):
        src = (ROOT / "pipeline" / module).read_text()
        clean = "import random" not in src and "random." not in src
        result.add(f"pipeline/{module} uses no RNG", clean)

    # Carried nodes stay within the displacement budget when a new node joins.
    previous = {k: (v.x, v.y) for k, v in first.items()}
    grown = layout.compute(
        [*ids, "fraud_check"],
        [*el, ("classify", "fraud_check", 9), ("fraud_check", "emit", 9)],
        previous,
    )
    over = layout.over_budget(grown)
    result.add(
        f"carried nodes stay within the {layout.DISPLACEMENT_BUDGET:.0f}px displacement budget",
        not over,
        "" if not over else f"over: {over}",
    )
    result.add(
        "a new node with positioned neighbours is seeded by centroid, not perimeter",
        grown["fraud_check"].layout_reason == "seeded_centroid",
        grown["fraud_check"].layout_reason,
    )
    result.add(
        "layout_reason distinguishes carried from newly placed",
        {p.layout_reason for p in grown.values()} & {"carried", "relaxed"} != set(),
    )
    result.add(
        "coordinates are rounded so the artifact does not churn",
        all(round(p.x, layout.PRECISION) == p.x for p in first.values()),
    )
    for bad in (float("inf"), float("nan")):
        try:
            layout.compute(ids, el, {ids[0]: (bad, 1.0)})
            refused = False
        except layout.LayoutError:
            refused = True
        result.add(f"non-finite carried position refused ({bad})", refused)


def check_build(result: Result) -> None:
    """Stage 1.3. The property is that build N+1 reproduces build N, across
    PROCESSES — not within one."""
    import subprocess
    import tempfile

    root = ROOT
    py = sys.executable
    script = root / "pipeline" / "build.py"
    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)
        state = tmpdir / "layout-state.json"
        outs = [tmpdir / f"p{i}.json" for i in (1, 2, 3)]
        ok = True
        for out in outs:
            proc = subprocess.run(
                [py, str(script), "--state", str(state), "--out", str(out),
                 "--html", str(tmpdir / (out.stem + ".html"))],
                capture_output=True,
                text=True,
                cwd=root,
            )
            ok = ok and proc.returncode == 0
        result.add("build runs three times cleanly", ok)
        if not ok:
            return

        bodies = [o.read_text() for o in outs]
        result.add(
            "builds 2 and 3 are byte-identical over unchanged inputs",
            bodies[1] == bodies[2],
            "" if bodies[1] == bodies[2] else "the artifact churns on every build",
        )
        payloads = [json.loads(b) for b in bodies]
        pos = [{n["id"]: (n["x"], n["y"]) for n in p["nodes"]} for p in payloads]
        result.add("coordinates survive a second process", pos[0] == pos[1])
        result.add(
            "layout_version does not bump when nothing changed",
            payloads[1]["layout_version"] == payloads[2]["layout_version"],
        )
        result.add(
            "an unchanged rebuild reports every node as carried",
            {n["layout_reason"] for n in payloads[2]["nodes"]} == {"carried"},
        )

        # Adding a node must accommodate it WITHOUT breaking the budget.
        topo = json.loads((root / "fixtures" / "topology.json").read_text())
        topo["nodes"].append(
            {
                "id": "fraud_check",
                "kind": "agent",
                "instrumentation": "new",
                "telemetry_coverage": "full",
            }
        )
        topo["edges"] += [
            {"source": "classify", "target": "fraud_check", "telemetry_coverage": "full"},
            {"source": "fraud_check", "target": "human_gate", "telemetry_coverage": "full"},
        ]
        topo_path = tmpdir / "topo2.json"
        topo_path.write_text(json.dumps(topo))
        grown = tmpdir / "p4.json"
        proc = subprocess.run(
            [py, str(script), "--state", str(state), "--topology", str(topo_path),
             "--out", str(grown), "--html", str(tmpdir / "grown.html")],
            capture_output=True, text=True, cwd=root,
        )
        result.add("build accepts a new node", proc.returncode == 0, proc.stderr[-160:])
        if proc.returncode != 0:
            return
        after = json.loads(grown.read_text())
        pa = {n["id"]: (n["x"], n["y"]) for n in after["nodes"]}
        import math

        worst = max(math.dist(pos[2][k], pa[k]) for k in pos[2])
        result.add(
            "existing nodes stay within the displacement budget when one is added",
            worst <= 52.0 + 0.1,
            f"max {worst:.1f}px",
        )
        new_node = next(n for n in after["nodes"] if n["id"] == "fraud_check")
        result.add(
            "the new node is seeded by centroid, not dropped on the perimeter",
            new_node["layout_reason"] == "seeded_centroid",
            new_node["layout_reason"],
        )
        result.add(
            "layout_version bumps when the topology DOES change",
            after["layout_version"] == payloads[2]["layout_version"] + 1,
        )
        for key in ("generated_at", "data_through", "expected_report_interval_seconds"):
            result.add(f"payload carries {key}", key in after)


def check_emit(result: Result) -> None:
    """Stage 1.4. Escaping is verified against the REAL hostile strings, and
    the payload must survive the escaping intact — a mangled payload is a
    different failure with the same symptom."""
    sys.path.insert(0, str(ROOT / "pipeline"))
    try:
        import emit  # type: ignore[import-not-found]
    except ImportError as exc:
        result.add("emit module importable", False, str(exc))
        return
    result.add("emit module importable", True)

    breakout = "</script><img src=x onerror=alert(1)>"
    separator = "a\u2028b=1"
    payload = {
        "schema_version": 1,
        "graph_id": breakout,
        "layout_version": 1,
        "generated_at": "2026-08-05T18:00:00Z",
        "data_through": "2026-08-05T17:42:00Z",
        "expected_report_interval_seconds": 3600,
        "nodes": [
            {
                "id": separator,
                "layout_reason": "carried",
                "x": 1,
                "y": 2,
                "lifetime_execution_count": 3,
                "render": {
                    "construction": "measured",
                    "radius": 10.0,
                    "fill_state": "normal",
                    "border": "full",
                    "glyph": "agent",
                    "annotation": "",
                },
            }
        ],
        "edges": [
            {
                "source": separator,
                "target": separator,
                "edge_state": "active",
                "lifetime_traversal_count": 3,
                "render": {"construction": "measured", "rail_width": 1.386, "core_luminance": 1.0},
            }
        ],
    }
    page = emit.emit(payload)
    result.add("script-block breakout does not survive", "</script><img" not in page)
    result.add("raw onerror handler does not survive", "<img src=x onerror" not in page)
    result.add("U+2028 is escaped (a JS line terminator)", "\u2028" not in page)

    blob = page.split('id="mind-data">', 1)[1].split("</script>", 1)[0]
    try:
        back = json.loads(blob)
        intact = back["graph_id"] == breakout and back["nodes"][0]["id"] == separator
    except json.JSONDecodeError:
        intact = False
    result.add("payload round-trips through the escaping intact", intact)

    # Staleness must be computed in the page, not baked at build time.
    built = DIST.read_text(encoding="utf-8") if DIST.is_file() else ""
    result.add(
        "visible ages are computed in the page from embedded timestamps",
        "Date.now()" in built and "generated_at" in built,
    )


def check_render_nodes(result: Result) -> None:
    """Stage 2.2. Asserted on the payload the renderer CONSUMES and on the
    drawing code's branch structure — a token grep would prove only that the
    code ran."""
    import math
    import re

    if not DIST.is_file():
        result.add("rendered page exists for node checks", False)
        return
    html_text = DIST.read_text(encoding="utf-8")
    payload = json.loads(html_text.split('id="mind-data">', 1)[1].split("</script>", 1)[0])
    js = html_text.split("<script>")[1].split("</script>")[0]

    ghost = next(n for n in payload["nodes"] if n["id"] == "legacy_scorer")
    result.add(
        "uninstrumented node is baked as UNKNOWN, not decided in the browser",
        ghost["render"]["construction"] == "unknown",
    )
    result.add(
        "uninstrumented node carries no fill state at all",
        ghost["render"]["fill_state"] is None,
    )

    # The structural half: fillFor must have no default that yields a colour.
    match = re.search(r"function fillFor\(state\)\{(.*?)\n\}", js, re.S)
    result.add("fillFor exists", match is not None)
    if match:
        result.add(
            "fillFor returns null by default, never a colour",
            "return null" in match.group(1),
        )

    # Every measured node must resolve to a fill fillFor recognises; anything
    # else falls through to hatching, which would be a silent downgrade.
    recognised = {"normal", "stale", "never_executed"}
    unrecognised = [
        n["id"]
        for n in payload["nodes"]
        if n["render"]["construction"] == "measured"
        and n["render"]["fill_state"] not in recognised
    ]
    result.add(
        "every measured node has a fill state the renderer recognises",
        not unrecognised,
        f"unrecognised: {unrecognised}" if unrecognised else "",
    )

    # Radius must match the published formula exactly — the legend prints it,
    # so a mismatch would make the legend a lie.
    wrong = []
    for node in payload["nodes"]:
        count, radius = node["lifetime_execution_count"], node["render"]["radius"]
        if count is None:
            if radius != 6.0:
                wrong.append(node["id"])
        elif abs(radius - min(6.0 + 3.4 * math.sqrt(math.log1p(count)), 26.0)) > 0.01:
            wrong.append(node["id"])
    result.add("every radius matches the formula the legend prints", not wrong, str(wrong))

    for primitive in ("shadowBlur", "shadowColor", "createRadialGradient"):
        result.add(f"no glow primitive: {primitive}", primitive not in js)

    result.add(
        "border encodes evidence quality, not health",
        "R.border" in js and "fill_state" not in js.split("BORDER")[1].split("GLYPH")[0],
    )
    result.add(
        "coordinates are read from the payload, never computed",
        "n.x" in js and "n.y" in js,
    )


def check_render_edges(result: Result) -> None:
    """Stage 2.3. The distinction this artifact exists for, asserted on the
    payload the renderer consumes and on the drawing code's null handling."""
    import math

    if not DIST.is_file():
        result.add("rendered page exists for edge checks", False)
        return
    html_text = DIST.read_text(encoding="utf-8")
    payload = json.loads(html_text.split('id="mind-data">', 1)[1].split("</script>", 1)[0])
    js = html_text.split("<script>")[1].split("</script>")[0]
    edges = {(e["source"], e["target"]): e for e in payload["edges"]}

    dormant = edges[("classify", "fetch_invoice")]["render"]
    never = edges[("fetch_invoice", "human_gate")]["render"]
    unknown = edges[("legacy_scorer", "emit")]["render"]

    width = lambda r: None if r["rail_width"] is None else 1 + r["rail_width"] * 0.95  # noqa: E731
    ratio = width(dormant) / width(never)
    result.add(
        "dormant rail is unmistakably wider than never-observed",
        ratio >= 2.0,
        f"{ratio:.1f}x ({width(dormant):.2f}px vs {width(never):.2f}px)",
    )
    result.add(
        "dormant draws a core (dark), never-observed draws none",
        dormant["core_luminance"] == 0.0 and never["core_luminance"] is None,
    )
    result.add(
        "unknown coverage claims neither width nor recency",
        unknown["rail_width"] is None and unknown["core_luminance"] is None,
    )

    # null must not be coerced to 0 anywhere — that is how the two collapse.
    result.add(
        "renderer distinguishes null core strictly, not falsily",
        "core_luminance !== null" in js,
    )
    result.add(
        "renderer distinguishes null rail strictly, not falsily",
        "rail_width === null" in js,
    )

    # The rail must be a pure function of the count, with no decay term.
    wrong = []
    for edge in payload["edges"]:
        count, rail = edge["lifetime_traversal_count"], edge["render"]["rail_width"]
        if count is None:
            if rail is not None:
                wrong.append(f"{edge['source']}->{edge['target']}")
        elif abs(rail - math.log1p(count)) > 1e-4:
            wrong.append(f"{edge['source']}->{edge['target']}")
    result.add("every rail width is exactly log1p(count), never decayed", not wrong, str(wrong))

    # 2.4 — each state must carry a mark that is a different KIND of thing,
    # not just a different magnitude. Width alone demands a comparison against
    # another edge, which is a judgement the eye should not have to make.
    marks = {
        "never_observed": ("edge_state === 'never_observed'", "setLineDash([4, 4])", "arc(a.x + ux*14"),
        "retired": ("edge_state === 'retired'", "px*6"),
        "unknown": ("rail_width === null", "fillText('?'"),
    }
    present = {e["edge_state"] for e in payload["edges"]}
    for state, needles in marks.items():
        result.add(f"fixture exercises the {state} state", state in present)
        missing = [n for n in needles if n not in js]
        result.add(f"{state} carries its own endpoint marker", not missing, str(missing))

    # The unknown branch must return before any rail is drawn, or an edge with
    # no coverage would still assert a width.
    result.add(
        "unknown coverage returns before any rail is drawn",
        js.index("rail_width === null") < js.index("HISTORY RAIL"),
    )

    # 2.6 — the legend must be DERIVED from the contract's constants, not
    # typed alongside them. A legend that prints a coefficient the renderer no
    # longer uses is worse than no legend, because it is believed.
    # Imported by name, not re-executed from the file: a second execution of a
    # module full of dataclasses fails, because dataclasses resolve annotations
    # through sys.modules and the fresh module was never registered there.
    sys.path.insert(0, str(ROOT / "pipeline"))
    import contract as contract_mod  # type: ignore[import-not-found]

    caption = html_text.split('<p class="caption">')[1].split("</p>")[0]
    for name, value in (
        ("RADIUS_MIN", contract_mod.RADIUS_MIN),
        ("RADIUS_K", contract_mod.RADIUS_K),
        ("RADIUS_CAP", contract_mod.RADIUS_CAP),
    ):
        result.add(
            f"legend is derived — prints the live {name} ({value})",
            str(value) in caption,
        )
    result.add(
        "legend prints the transform, not a bare 'brighter = more active'",
        "log1p" in caption and "sqrt" in caption,
    )
    # Worked examples must come from edges that exist, so every number in the
    # legend is one the reader can find on the canvas.
    counts = {
        str(e["lifetime_traversal_count"])
        for e in payload["edges"]
        if e["lifetime_traversal_count"]
    }
    cited = [c for c in counts if c in caption]
    result.add(
        "worked examples cite real traversal counts from this graph",
        len(cited) >= 2,
        f"cited {sorted(cited)}",
    )

    # 2.5 — the gate. Section 3c's verdict is a rectangle, not a diamond: a
    # diamond is the flowchart symbol for a decision that BRANCHES, and this
    # gate chooses no path. It is a checkpoint a person signed.
    gated = [e for e in payload["edges"] if "gate" in e]
    result.add("fixture exercises at least one gate", len(gated) > 0, f"{len(gated)} gates")
    dispositions = {e["gate"]["disposition"] for e in gated}
    for want in ("awaiting", "approved", "rejected"):
        result.add(f"gate disposition exercised: {want}", want in dispositions)

    segment = js.split("GATE — a RECTANGLE")[1].split("ENDPOINT MARKERS")[0]
    result.add("gate is a RECTANGLE, not a diamond", "strokeRect" in segment)
    result.add(
        "gate glyph is drawn unrotated so it stays readable at any edge angle",
        segment.index("restore()") < segment.index("fillText"),
    )
    result.add(
        "an awaiting gate is drawn louder than a decided one",
        "=== 'awaiting'" in segment,
    )
    result.add(
        "every gate carries a glyph",
        all(e["gate"].get("glyph") for e in gated),
    )

    # Edges are drawn before nodes, so a node is never hidden by its own wire.
    result.add(
        "edges are drawn before nodes",
        js.index("EDGES FIRST") < js.index("D.nodes.length; i++"),
    )


def check_artifact_matches_topology(result: Result) -> None:
    """The delivered file must describe the REAL graph.

    Reproduced: `check_build`'s "add a node" test ran the pipeline without
    `--html`, so it overwrote dist/index.html with a synthetic topology and the
    published artifact showed a `fraud_check` node that does not exist. A test
    contaminating the artifact it is testing is the worst kind of green.
    """
    if not DIST.is_file():
        result.add("artifact matches the declared topology", False, "no artifact")
        return
    payload = json.loads(
        DIST.read_text(encoding="utf-8").split('id="mind-data">', 1)[1].split("</script>", 1)[0]
    )
    topo = json.loads((ROOT / "fixtures" / "topology.json").read_text())
    declared = {n["id"] for n in topo["nodes"]}
    rendered = {n["id"] for n in payload["nodes"]}
    result.add(
        "artifact contains exactly the declared nodes",
        rendered == declared,
        f"extra={sorted(rendered - declared)} missing={sorted(declared - rendered)}",
    )
    result.add(
        "artifact edge count matches the declared topology",
        len(payload["edges"]) == len(topo["edges"]),
        f"{len(payload['edges'])} vs {len(topo['edges'])}",
    )


CHROME_CANDIDATES = (
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "/usr/bin/chromium",
    "/usr/bin/google-chrome",
)


def _chrome() -> str | None:
    import shutil

    for candidate in CHROME_CANDIDATES:
        if Path(candidate).is_file():
            return candidate
    for name in ("chromium", "google-chrome", "chrome"):
        found = shutil.which(name)
        if found:
            return found
    return None


def check_pixel_stability(result: Result) -> None:
    """Stage 3.1 — zero coordinate drift between two OPENS, tested by actually
    opening the file twice in a headless browser and comparing pixels.

    Reasoning about the drawing code would only show that today's code reads
    baked coordinates. Rendering it proves the page as delivered puts the same
    marks in the same places.

    **The canvas is cropped out before comparison, and that is not a
    convenience.** The header stamp reports the file's own age from
    `Date.now()`, so it is SUPPOSED to change between opens — comparing whole
    pages would be flaky in a way that punishes the staleness feature for
    working. The canvas region carries the coordinates; the stamp carries time.
    """
    chrome = _chrome()
    if chrome is None:
        result.add(
            "pixel stability across two opens",
            False,
            "no headless browser found — recorded in MANUAL_CHECKS, not skipped",
        )
        return
    if not DIST.is_file():
        result.add("pixel stability across two opens", False, "no artifact")
        return

    import subprocess
    import tempfile

    try:
        from PIL import Image  # type: ignore[import-not-found]
    except ImportError:
        result.add("pixel stability across two opens", False, "PIL unavailable")
        return

    with tempfile.TemporaryDirectory() as tmp:
        shots = []
        for i in (1, 2):
            out = Path(tmp) / f"open{i}.png"
            proc = subprocess.run(
                [
                    chrome, "--headless", "--disable-gpu", "--hide-scrollbars",
                    "--force-device-scale-factor=1", "--window-size=1200,1400",
                    "--virtual-time-budget=3000",
                    # Offline, genuinely: the renderer is not allowed to reach
                    # the network even if something tried.
                    "--disable-features=NetworkService",
                    f"--screenshot={out}", DIST.as_uri(),
                ],
                capture_output=True, timeout=90,
            )
            if not out.is_file():
                result.add(
                    "pixel stability across two opens",
                    False,
                    f"screenshot failed: {proc.stderr[-160:]!r}",
                )
                return
            shots.append(out)

        first, second = (Image.open(s).convert("RGB") for s in shots)
        result.add("the page renders offline in a headless browser", True)

        # Crop to the canvas band, below the header stamp.
        box = (0, 260, min(first.width, second.width), min(first.height, second.height))
        a, b = first.crop(box), second.crop(box)
        import numpy as np  # type: ignore[import-not-found]

        diff = np.abs(np.asarray(a, dtype=int) - np.asarray(b, dtype=int))
        changed = int((diff.sum(axis=2) > 0).sum())
        result.add(
            "zero coordinate drift between two opens (canvas pixels identical)",
            changed == 0,
            f"{changed} differing pixels",
        )


def check_dist(result: Result) -> None:
    if not DIST.is_file():
        result.add("dist/index.html exists", False, "not built yet — expected before Stage 2")
        return
    result.add("dist/index.html exists", True)
    html = DIST.read_text(encoding="utf-8")
    scan_forbidden(html, result)
    check_payload(html, result)
    siblings = [p for p in DIST.parent.iterdir() if p != DIST]
    result.add(
        "single file — no sibling assets in dist/",
        not siblings,
        "" if not siblings else f"found {[p.name for p in siblings]}",
    )


def contract_gate_self_test() -> list[str]:
    """The Stage 0 gate must be able to FAIL, or its green is worthless.

    Four planted faults plus a control. The control matters as much as the
    faults: a gate that always raised would catch all four and be useless.
    """
    sys.path.insert(0, str(ROOT / "pipeline"))
    try:
        import contract  # type: ignore[import-not-found]
    except ImportError:
        print("  FAIL  contract gate self-test (module not importable)")
        return ["contract gate"]

    saved = contract.ALL_CHANNELS
    undetected: list[str] = []

    def expect_raise(label: str, fn) -> None:  # type: ignore[no-untyped-def]
        try:
            fn()
            undetected.append(label)
            print(f"  FAIL  gate detects {label}")
        except contract.ContractError:
            print(f"  PASS  gate detects {label}")

    try:
        contract.ALL_CHANNELS = tuple(c for c in saved if c.name != "node.border")
        expect_raise("a required property with no backing field", contract.assert_complete)
        contract.ALL_CHANNELS = saved

        contract.ALL_CHANNELS = saved + (
            contract.Channel(name="node.glow", backing=("vibes",), describes="invented"),
        )
        expect_raise("a channel the spec never asked for", contract.assert_complete)
        contract.ALL_CHANNELS = saved

        names = {c.name for c in saved}
        expect_raise(
            "a renderer painting an unbacked property",
            lambda: contract.assert_complete(painted=names | {"node.halo"}),
        )
        expect_raise(
            "a declared channel no painter uses",
            lambda: contract.assert_complete(painted=names - {"gate.glyph"}),
        )

        try:
            contract.assert_complete(painted=names | set(contract.CONSTANT_PROPERTIES))
            print("  PASS  gate does NOT fire on an honest renderer")
        except contract.ContractError as exc:
            undetected.append(f"false positive on honest renderer: {exc}")
            print("  FAIL  gate does NOT fire on an honest renderer")
    finally:
        contract.ALL_CHANNELS = saved

    return undetected


def self_test() -> int:
    """Plant each fault and assert the check fires. A scanner that cannot
    detect is not a scanner — this program has three ADRs about detectors that
    passed their own planted-fault check and were still wrong, so the faults
    here are the REAL tokens, never paraphrases."""
    planted = [
        ("fetch(", '<script>fetch("http://x")</script>'),
        ("XMLHttpRequest", "<script>new XMLHttpRequest()</script>"),
        ("WebSocket", "<script>new WebSocket('ws://x')</script>"),
        ("sendBeacon", "<script>navigator.sendBeacon('/x')</script>"),
        ("<form", '<form action="/x"></form>'),
        ("localStorage", "<script>localStorage.setItem('a','b')</script>"),
        ("sessionStorage", "<script>sessionStorage.getItem('a')</script>"),
        ("indexedDB", "<script>indexedDB.open('a')</script>"),
        ("src=http", '<script src="https://cdn.example.com/d3.js"></script>'),
        ("href=http", '<link href="https://fonts.example.com/f.css">'),
        ("@import", "<style>@import url(x.css);</style>"),
        ("url(http", "<style>body{background:url(https://x/y.png)}</style>"),
        ("Math.random", "<script>var p=Math.random()</script>"),
        ("forceSimulation", "<script>d3.forceSimulation(nodes)</script>"),
        ("forceLink", "<script>.force('link', forceLink(links))</script>"),
        ("forceManyBody", "<script>forceManyBody().strength(-30)</script>"),
        ("velocityDecay", "<script>sim.velocityDecay(0.4)</script>"),
        ("simulation.tick", "<script>sim.tick(120)</script>"),
        ("LIVE", "<p>LIVE</p>"),
    ]
    failures = []
    for label, snippet in planted:
        r = Result()
        scan_forbidden(snippet, r)
        if not r.failed:
            failures.append(label)
    # And the inverse: a clean document must produce no findings.
    clean = Result()
    scan_forbidden("<p>generated 3 days ago</p>", clean)
    if clean.failed:
        failures.append(f"false positive on a clean document: {clean.failed}")

    gate_checks = 5  # four planted faults plus the honest-renderer control
    failures.extend(contract_gate_self_test())

    for label, snippet in planted:
        mark = "PASS" if label not in failures else "FAIL"
        print(f"  {mark}  detects {label}")
    print(f"  {'PASS' if not any('false positive' in f for f in failures) else 'FAIL'}  no false positive on clean input")
    print()
    if failures:
        print(f"SELF-TEST: FAIL — undetected: {failures}")
        return 1
    # Count everything that ran, not just the token scan. A self-test that
    # under-reports its own coverage is the same defect class as a dashboard
    # that under-reports what it cannot see.
    print(
        f"SELF-TEST: PASS ({len(planted)} planted tokens + {gate_checks} contract-gate "
        f"checks = {len(planted) + gate_checks} detections, no false positives)"
    )
    return 0


def main(argv: list[str]) -> int:
    if "--self-test" in argv:
        return self_test()
    result = Result()
    check_fixtures(result)
    check_contract(result)
    check_traversal(result)
    check_layout(result)
    check_build(result)
    check_emit(result)
    check_render_nodes(result)
    check_render_edges(result)
    check_pixel_stability(result)
    check_artifact_matches_topology(result)
    check_dist(result)
    return result.report()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
